APP_NAME="New LIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=new_lims
DB_USERNAME=root
DB_PASSWORD=
BACKUP_SOURCE_DB_CONNECTION=${DB_CONNECTION}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:5174,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
BACKUP_QUEUE_CONNECTION=backups
BACKUP_QUEUE=backups
BACKUP_QUEUE_RETRY_AFTER=1920
BACKUP_JOB_TIMEOUT=1800

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Java PDF renderer/signer (services/pdf-renderer-java). The port matches that
# service's loopback-only Docker mapping. Direct JAR runs on container port
# 8081 and therefore require an explicit override.
PDF_SERVICE_ENABLED=false
PDF_SIGNING_ORGANIZATION_SCOPE=default
PDF_SERVICE_BASE_URL=http://127.0.0.1:8080
PDF_SERVICE_HMAC_ENABLED=true
PDF_SERVICE_HMAC_ACTIVE_KEY_ID=primary
# Comma-separated key-id:base64-secret entries. Generate at least 32 random
# bytes per key and configure the exact same value in the Java service.
PDF_SERVICE_HMAC_KEYS=
PDF_WORKFLOW_SOURCE_MAX_BYTES=20971520
PDF_WORKFLOW_GENERATED_REVISION_MAX_BYTES=33554432
PDF_WORKFLOW_OPERATION_LEASE_SECONDS=300

# PDF 防篡改签章
PDF_SIGNING_ENABLED=true
PDF_SIGNING_DOWNLOAD_LINK_TTL_MINUTES=30
PDF_SIGNING_MAX_UPLOAD_KB=20480
# RFC 3161 is intentionally unavailable until the Java service embeds and
# independently verifies a real signature timestamp token.
# 处理光度数据后签名：从 zs-lims 完整迁移但默认关闭。开启前需先执行
# composer require setasign/fpdi-tcpdf tecnickcom/tcpdf smalot/pdfparser
PDF_SIGNING_PHOTOMETRIC_REMOVAL_ENABLED=false

# 免登录的报告核验页 /verify
PDF_PUBLIC_VERIFICATION_ENABLED=true
PDF_PUBLIC_VERIFICATION_STORE_UPLOADS=false

# 部署布局相关。仅在 current -> releases/<sha> 这类原子发布中需要：
# storage_path() 默认由 release 目录推导，一旦被写进 config 缓存，指向的就是
# 某一次发布的目录；该目录被替换或清理后，上传的文件与日志会写到一个失效路径，
# 表面上记录还在、文件却读不出来。指向共享目录即可让路径与发布无关。
# 本地开发留空。
LARAVEL_STORAGE_PATH=
