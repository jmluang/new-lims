.DS_Store

# Local tooling: launch configs hold machine-specific paths, and .vite is a cache.
/.claude/
/.vite/

/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/storage/*.key

/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.local
/backend/public/app/

/services/pdf-renderer-java/target/
/services/pdf-renderer-java/keys/
/services/pdf-renderer-java/test_*.pdf

# Reference-only directories. Keep them local and out of the new project history.
/example/
/zs-lims/
